# =============================================================================
# .env.example — Dalang-AI Auth Platform environment variable template
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
#   cp .env.example .env
#
# ⚠  NEVER commit your real .env file to version control.
# =============================================================================


# ─── Backend: JWT / Token Service ────────────────────────────────────────────

# REQUIRED — Long, random secret key used to sign JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-64-chars

# JWT signing algorithm. Supported: HS256, HS384, HS512
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 15)
JWT_ACCESS_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
JWT_REFRESH_EXPIRE_DAYS=7

# Optional: JWT issuer claim (e.g. https://auth.dalang-ai.io)
JWT_ISSUER=

# Optional: JWT audience claim (e.g. dalang-ai-api)
JWT_AUDIENCE=


# ─── Backend: Uvicorn / Application Server ───────────────────────────────────

# Host interface to bind (0.0.0.0 for all interfaces inside container)
APP_HOST=0.0.0.0

# Port the backend API listens on inside the container
APP_PORT=8000

# Number of Uvicorn worker processes (set to 1 for dev; scale up for prod)
APP_WORKERS=1

# Uvicorn log level: debug | info | warning | error | critical
APP_LOG_LEVEL=info


# ─── Backend: CORS ───────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS (e.g. http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000


# ─── Frontend: Nginx ─────────────────────────────────────────────────────────

# Host port that the Nginx frontend is exposed on (maps to container port 80)
FRONTEND_PORT=80

# The URL the browser uses to reach the backend API.
# In production, set this to your public API domain.
VITE_API_BASE_URL=http://localhost:8000


# ─── Docker Compose: Port Mappings ───────────────────────────────────────────

# Host port for the backend API (maps to APP_PORT inside the container)
BACKEND_PORT=8000


# ─── Environment Tag ─────────────────────────────────────────────────────────

# Deployment environment label: development | staging | production
# Set to 'production' to enforce JWT_SECRET_KEY (default secret rejected)
APP_ENV=production
